[Unit]
Description=JARVIS Go Sidecar (WS fan-out)
After=jarvis-brain.service
Wants=jarvis-brain.service

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/jarvis/src/sidecar
EnvironmentFile=/home/%i/jarvis/.env
ExecStart=/home/%i/jarvis/src/sidecar/sidecar --brain http://localhost:8001
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
