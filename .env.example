# Jarvis Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to version control — it's in .gitignore.

# ─── LLM Providers ────────────────────────────────────────────────────────────
# Phase 0 defaults: Groq (fast-path) + Gemini (balanced) are enough to start.
# Add others as fallbacks when you have the keys.

# Groq — free tier, fastest inference, ideal for routing decisions + fast-path
GROQ_API_KEY=

# Google Gemini — cheap, generous free tier, good balanced model
GEMINI_API_KEY=

# Anthropic (Claude) — best for complex planning/reasoning; add when available
ANTHROPIC_API_KEY=

# OpenAI (GPT-4, o-series) — vision tasks + fallback
OPENAI_API_KEY=

# xAI (Grok) — reasoning-heavy tasks; use with the grok CLI or directly via LiteLLM
XAI_API_KEY=
GROK_API_KEY=   # alias — xAI accepts either

# Mistral — used by the vibe CLI; add if using Mistral models directly
MISTRAL_API_KEY=

# OpenRouter — hosted multi-model; use as one upstream behind LiteLLM
OPENROUTER_API_KEY=

# ─── LiteLLM ──────────────────────────────────────────────────────────────────
LITELLM_LOG=WARNING
LITELLM_DROP_PARAMS=true

# ─── Memory ───────────────────────────────────────────────────────────────────
SQLITE_PATH=./data/jarvis.db

# Mem0 vector store path (ChromaDB; future: sqlite-vec)
MEM0_CHROMA_PATH=./data/mem0_chroma

# Mem0 LLM model for memory extraction (uses GROQ_API_KEY)
MEM0_LLM_MODEL=groq/llama-3.1-8b-instant

# Mem0 embedding model — requires OPENAI_API_KEY
MEM0_EMBED_MODEL=openai/text-embedding-3-small

# ─── Brain ────────────────────────────────────────────────────────────────────
BRAIN_PORT=8001
BRAIN_INTERNAL_URL=http://localhost:8001

# ─── Gateway ──────────────────────────────────────────────────────────────────
GATEWAY_PORT=8080
GATEWAY_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALLOWED_ORIGIN=http://localhost:3000

# ─── Website ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:8080

# ─── Voice Pipeline ───────────────────────────────────────────────────────────
# STT: deepgram | whisper_openai | assemblyai | azure_speech
# Recommendation: deepgram for lowest latency
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# Whisper via OpenAI API (alternative STT)
# Uses OPENAI_API_KEY above

# AssemblyAI (alternative STT — good free tier)
ASSEMBLYAI_API_KEY=

# ── TTS Provider — switch with one env var ─────────────────────────────────────
# Options: piper | kokoro | elevenlabs | cartesia | fish_audio | openai
# piper / kokoro = free, local CPU, no API key needed
# elevenlabs = best cloud quality (Bill voice)
# cartesia = fastest cloud (<60ms), cheapest at scale
# fish_audio = free tier, clone from 15s clip
JARVIS_TTS_PROVIDER=piper          # free by default; switch to elevenlabs when ready
JARVIS_TTS_FALLBACK=kokoro         # if primary fails
JARVIS_STT_PROVIDER=groq           # groq | deepgram

# ElevenLabs — Bill voice (closest to MCU JARVIS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pqHfZKP75CvOlQylNhV4   # Bill
ELEVENLABS_MODEL=eleven_turbo_v2_5          # half cost, same quality

# Cartesia Sonic — sub-60ms streaming
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=    # pick a British male voice at play.cartesia.ai

# Fish Audio — free tier, clone from 15s clip at fish.audio
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=   # voice model ID after creating a clone at fish.audio

# Kokoro — local CPU, free, British bm_george voice
KOKORO_VOICE=bm_george
KOKORO_SPEED=0.95

# OpenAI TTS (fallback — uses OPENAI_API_KEY above)
OPENAI_TTS_VOICE=onyx

# Wake word mode: wakeword | push-to-talk | always-on
VOICE_MODE=wakeword

# Wake word detection (openWakeWord)
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.7

# Voice pipeline ports
VOICE_WS_PORT=8765
VOICE_LLM_MODEL=llama-3.1-8b-instant

# Voice WebSocket proxied through gateway at /voice
VOICE_WS_URL=ws://localhost:8765
# Browser-facing voice pipeline URL (proxied through nginx /voice-pipeline/)
NEXT_PUBLIC_VOICE_URL=wss://your-domain/voice-pipeline
NEXT_PUBLIC_GATEWAY_TOKEN=dev-token

# ─── Push Notifications — Telegram ────────────────────────────────────────────
# Create a bot: https://t.me/BotFather → /newbot → copy the token
# Get your chat_id: message your bot, then:
#   curl https://api.telegram.org/bot<TOKEN>/getUpdates
PUSH_PROVIDER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Additional LLM Providers ─────────────────────────────────────────────────

# DeepSeek — strong coding/reasoning, cheap
DEEPSEEK_API_KEY=

# Perplexity — real-time web search augmented responses
PERPLEXITY_API_KEY=

# xAI (Grok 3) — reasoning + vision
XAI_API_KEY=

# Mistral — European provider, codestral for code
MISTRAL_API_KEY=

# OpenRouter — 300+ models via single key, has free tier
OPENROUTER_API_KEY=

# Cerebras — fastest inference (<100ms TTFT)
CEREBRAS_API_KEY=

# Together AI — cheap open model hosting
TOGETHER_API_KEY=

# Fireworks AI — fast open model inference
FIREWORKS_AI_API_KEY=

# AWS Bedrock — Claude via AWS (jarvis-coder)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# Alibaba Cloud (DashScope) — Qwen models
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# TokenHarbor — free DeepSeek tier
TOKEN_HARBOR_API_KEY=
TOKEN_HARBOR_BASE_URL=https://tokenharbor.io/api/v1

# AiHubMix — 415 models, free tier
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com/v1

# CodeCraft — 1M tokens/month free
CODECRAFT_API_KEY=
CODECRAFT_BASE_URL=https://api.codecraft.ai/v1

# Cloudflare Workers AI — free tier, global edge inference
# Get from dash.cloudflare.com → AI → Workers AI → API token
CLOUDFLARE_API_KEY=
# Full URL: https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1

# Zhipu AI (Z.ai) — GLM family, free tier at open.bigmodel.cn
ZHIPUAI_API_KEY=

# NVIDIA NIM — free tier GPU inference at build.nvidia.com
NVIDIA_API_KEY=

# HuggingFace — serverless inference API, free tier
HUGGINGFACE_API_KEY=

# Pollinations (gen.pollinations.ai) — OpenAI-compatible, aggregates GPT/Claude/Gemini/Llama/Qwen/Mistral
# Get key at: gen.pollinations.ai → dashboard → API keys
POLLINATIONS_API_KEY=

# ─── Web & Research Tools ─────────────────────────────────────────────────────
TAVILY_API_KEY=
OPENWEATHER_API_KEY=

# ─── System ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
AZURE_VM_HOST=your-vm.region.cloudapp.azure.com
JARVIS_DATA_DIR=./data

# ─── PC Worker ────────────────────────────────────────────────────────────────
WORKER_ID=                          # defaults to hostname if unset
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_AZURE_ENDPOINT=http://${AZURE_VM_HOST}:${GATEWAY_PORT}/workers/register

# ─── Go Sidecar ───────────────────────────────────────────────────────────────
# Handles WebSocket fan-out (stats/logs/PC relay) with goroutine-per-client.
# Start: ./src/sidecar/sidecar.exe --brain http://localhost:8001
SIDECAR_PORT=8002

# ─── Watchdog ─────────────────────────────────────────────────────────────────
WATCHDOG_HEARTBEAT_TIMEOUT_SECONDS=120
WATCHDOG_TASK_MEMORY_LIMIT_MB=512

# ─── Smart Home (Home Assistant) ─────────────────────────────────────────────
# Long-lived access token: HA profile → Security → Long-Lived Access Tokens
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# ─── PC Agent (Phase 8) ───────────────────────────────────────────────────────
# Shared secret between brain and PC agent — generate with: openssl rand -hex 32
JARVIS_PC_TOKEN=change-me-generate-with-openssl-rand-hex-32
# URL the PC agent connects to (wss:// in prod, ws:// for local dev)
JARVIS_BRAIN_WS_URL=ws://localhost:8001/pc-ws
# Optional: double-clap wake trigger sensitivity (0.0-1.0)
CLAP_THRESHOLD=0.35

# ─── PC Desktop Control (Phase 8) ─────────────────────────────────────────────
# Discord: add --remote-debugging-port=9222 to Discord shortcut target once
DISCORD_CDP_PORT=9222
# WhatsApp: add --remote-debugging-port=9223 to WhatsApp Desktop shortcut target once
WHATSAPP_CDP_PORT=9223
